# ================================================================
# K8s 运维助手 Agent — 配置示例
# 复制此文件为 .env 并填入真实值，.env 已被 .gitignore 排除
# ================================================================

# ── LLM Provider ────────────────────────────────────────────────
# 可选值: anthropic | deepseek
LLM_PROVIDER=deepseek

# ── Anthropic Claude（LLM_PROVIDER=anthropic 时必填）────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-8

# ── DeepSeek（LLM_PROVIDER=deepseek 时必填）─────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Kubernetes ──────────────────────────────────────────────────
# kubeconfig 路径，留空则自动尝试 in-cluster 配置
KUBECONFIG=~/.kube/config
# 默认操作的 namespace
K8S_NAMESPACE=default

# ── Agent ───────────────────────────────────────────────────────
AGENT_MAX_TOKENS=4096
LOG_LEVEL=INFO

# ── Inspector（后台巡检）────────────────────────────────────────
# 是否启用定时巡检（true | false）
INSPECTOR_ENABLED=true
# 巡检轮询间隔（秒），调低可加快测试反馈
INSPECTOR_INTERVAL=60
# 同一资源告警冷却时间（分钟），窗口内重复异常不重复告警
INSPECTOR_COOLDOWN_MINUTES=30
# Pod 重启次数超过此阈值触发告警
INSPECTOR_RESTART_THRESHOLD=3
